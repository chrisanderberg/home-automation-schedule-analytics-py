data/snapshots/*.sqlite-*
test-data/*.sqlite
test-data/*.sqlite-*
test-data/*.db
test-data/*.dump
test-data/snapshots/*
!test-data/snapshots/.gitkeep
test-data/snapshots/*.sqlite
test-data/snapshots/*.sqlite-*

# dagster local runtime state
.tmp_dagster_home_*/
