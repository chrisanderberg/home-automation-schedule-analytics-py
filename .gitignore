__pycache__/
*.pyc

# env files with secrets (never commit)
.env
.env.local
.env.*
!.env.example
env/*.local
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# runtime sqlite artifacts
data/**/*.sqlite
data/**/*.sqlite-*
data/**/*.db
data/**/*.dump
data/**/snapshots/*
!data/**/snapshots/.gitkeep
test-data/**/*.sqlite
test-data/**/*.sqlite-*
test-data/**/*.db
test-data/**/*.dump
test-data/**/snapshots/*
!test-data/**/snapshots/.gitkeep

# dagster local runtime state
.tmp_dagster_home_*/
