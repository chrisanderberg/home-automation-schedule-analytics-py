# Copy to .env and fill in values. Never commit .env (see .gitignore).
# Required for Docker Compose:
HAA_LATITUDE=999.0
HAA_LONGITUDE=-999.0
DAGSTER_PG_PASSWORD=<your-dagster-pg-password>

# Optional: for external Postgres (defaults use local dagster_postgres service)
# DAGSTER_PG_HOST=dagster_postgres
# DAGSTER_PG_PORT=5432
# DAGSTER_PG_DB=dagster
# DAGSTER_PG_USERNAME=dagster
